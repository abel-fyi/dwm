+void
+togglescratch(const Arg *arg)
+{
+	Client *c = scratchpad;
+
+	if (!c) {
+		spawn(arg);
+		return;
+	}
+	if (c->mon == selmon && ISVISIBLE(c)) {
+		c->tags = 0;
+		focus(NULL);
+		arrange(selmon);
+		return;
+	}
+	if (c->mon != selmon)
+		sendmon(c, selmon);
+	c->tags = selmon->tagset[selmon->seltags] & TAGMASK;
+	c->isfloating = 1;
+	resize(c, selmon->wx + selmon->ww / 10, selmon->wy,
+	       selmon->ww * 4 / 5 - 2 * c->bw,
+	       selmon->wh * 2 / 5 - 2 * c->bw, 0);
+	focus(c);
+	arrange(selmon);
+	restack(selmon);
+}
